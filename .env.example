# Postgres
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
POSTGRES_DSN=postgres://aegis:aegis@postgres:5432/aegis

# Redis
REDIS_ADDR=redis:6379

# Service ports
GATEWAY_PORT=8080
IDENTITY_PORT=8081
BUDGET_PORT=8082
CONTAINMENT_PORT=8083
AUDIT_PORT=8084
RAILS_PORT=8090

# Inter-service addresses (used by gateway)
RAILS_ADDR=http://mock-rails:8090
AUDIT_ADDR=http://audit-chain:8084
IDENTITY_ADDR=http://identity-service:8081
POLICY_ADDR=http://cedar-agent:8180
BUDGET_ADDR=http://budget-ledger:8082
CONTAINMENT_ADDR=http://containment-controller:8083

# Identity-service
SIGNING_KEY_PATH=/data/identity_signing_key
BASE_LEASE_SECONDS=45
THROTTLE_LEASE_SECONDS=10
LEASE_JITTER_PCT=0.20

# Budget-ledger
REAPER_INTERVAL_SECONDS=5
DEMO_NAIVE_MODE=true
THROTTLE_VELOCITY_CAP_PER_MIN=5

# Gateway
EPOCH_STALENESS_BOUND_SECONDS=2

# Containment-controller
THROTTLE_VELOCITY_CAP_PER_MIN=5
